.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f7f4;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #777;
}

.loading-card,
.error-card,
.empty-card,
.weather-card,
.outfit-card,
.suggestion-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
}

.loading-card {
  color: #666;
  text-align: center;
}

.error-card {
  color: #c0392b;
}

.weather-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weather-city {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.weather-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.weather-temp {
  font-size: 56rpx;
  font-weight: 700;
  color: #5f8f6a;
}

.weather-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #666;
}

.weather-source {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.outfit-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
}

.clothes-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.clothing-item {
  display: flex;
  align-items: center;
  background: #f8f9f6;
  border-radius: 20rpx;
  padding: 16rpx;
}

.clothing-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: #eee;
  margin-right: 18rpx;
}

.clothing-info {
  flex: 1;
}

.clothing-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.clothing-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #777;
}

.reason {
  margin-top: 22rpx;
  padding: 18rpx;
  background: #eef5ec;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #4f7356;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
}

.suggestion-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #666;
}

.empty-card {
  color: #666;
  text-align: center;
}

.empty-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 30rpx;
  padding-bottom: 40rpx;
}

.primary-btn {
  background: #5f8f6a;
  color: #fff;
  border-radius: 999rpx;
}

.secondary-btn {
  background: #ffffff;
  color: #5f8f6a;
  border-radius: 999rpx;
}

.agent-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
}

.agent-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.agent-answer {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4f7356;
}

.agent-subtitle {
  margin-top: 22rpx;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #666;
}

.decision-step {
  font-size: 24rpx;
  line-height: 1.7;
  color: #666;
}

.tool-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tool-tag {
  padding: 8rpx 18rpx;
  background: #eef5ec;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #5f8f6a;
}

.save-wear-btn {
  margin-top: 22rpx;
  background: #5f8f6a;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.save-wear-btn::after {
  border: none;
}

.feedback-panel {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
}

.feedback-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.feedback-desc {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #888;
}

.feedback-row {
  margin-top: 18rpx;
}

.feedback-label {
  margin-bottom: 10rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #555;
}

.fb-btn {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 0 24rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: #f3f4f1;
  color: #666;
  font-size: 24rpx;
}

.fb-btn.active {
  background: #5f8f6a;
  color: #ffffff;
}

.fb-btn::after,
.submit-feedback-btn::after,
.close-feedback-btn::after {
  border: none;
}

.submit-feedback-btn {
  margin-top: 24rpx;
  background: #5f8f6a;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.close-feedback-btn {
  margin-top: 16rpx;
  background: #f3f4f1;
  color: #777;
  border-radius: 999rpx;
  font-size: 26rpx;
}