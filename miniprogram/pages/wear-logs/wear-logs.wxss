.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f7f4;
  box-sizing: border-box;
}

.manage-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5f8f6a;
  font-size: 25rpx;
}

.manage-btn::after {
  border: none;
}

.loading-card,
.empty-card,
.log-card,
.feedback-panel,
.batch-bar {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
}

.top-panel {
  border: 2rpx solid rgba(95, 143, 106, 0.18);
}

.loading-card,
.empty-card {
  text-align: center;
  color: #666;
}

.empty-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.panel-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5f8f6a;
}

.close-text {
  font-size: 24rpx;
  color: #999;
}

.feedback-row {
  margin-top: 22rpx;
}

.feedback-label {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #555;
}

.choice-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.fb-btn {
  margin: 0;
  min-width: 128rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f3f4f1;
  color: #666;
  font-size: 24rpx;
}

.fb-btn.wide {
  min-width: 170rpx;
}

.fb-btn.active {
  background: #5f8f6a;
  color: #ffffff;
}

.submit-feedback-btn {
  margin-top: 30rpx;
  background: #5f8f6a;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.submit-feedback-btn::after,
.fb-btn::after {
  border: none;
}

.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.batch-text {
  font-size: 26rpx;
  color: #666;
}

.batch-delete-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  background: #fff0ee;
  color: #d93025;
  font-size: 25rpx;
}

.batch-delete-btn::after {
  border: none;
}

.log-card {
  transition: all 0.2s ease;
}

.log-card.selected {
  border: 2rpx solid rgba(95, 143, 106, 0.32);
}

.log-card.checked {
  background: #eef5ec;
}

.log-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.log-main {
  flex: 1;
}

.log-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.log-weather {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #5f8f6a;
}

.date-edit {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef5ec;
  color: #5f8f6a;
  font-size: 23rpx;
}

.check-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #5f8f6a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.clothing-count {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #666;
}

.log-note {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #f8f9f6;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #777;
}

.tap-tip {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #999;
}

.header {
  margin-bottom: 24rpx;
}

.header-text {
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.2;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #777;
  line-height: 1.5;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.feedback-top-btn,
.manage-btn {
  flex: 1;
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  padding: 0;
}

.feedback-top-btn {
  background: #5f8f6a;
  color: #ffffff;
}

.feedback-top-btn[disabled] {
  background: #e5e8e2;
  color: #999999;
}

.manage-btn {
  background: #ffffff;
  color: #5f8f6a;
}

.feedback-top-btn::after,
.manage-btn::after {
  border: none;
}

.feedback-history-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid rgba(95, 143, 106, 0.16);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.history-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #777;
}

.small-add-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 999rpx;
  background: #5f8f6a;
  color: #ffffff;
  font-size: 24rpx;
}

.small-add-btn::after {
  border: none;
}

.no-feedback {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f8f9f6;
  color: #888;
  font-size: 25rpx;
}

.feedback-detail {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f8f9f6;
}

.feedback-detail-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
}

.feedback-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.feedback-item {
  width: 48%;
  font-size: 24rpx;
  color: #666;
}

.feedback-adjustment {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5f8f6a;
}

.feedback-count-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #999;
}

.feedback-status {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f4f1;
  color: #999;
  font-size: 23rpx;
}

.feedback-status.has-feedback {
  background: #eef5ec;
  color: #5f8f6a;
}

.inline-history-card {
  margin-top: -12rpx;
  margin-bottom: 24rpx;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}

.feedback-editor {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 2rpx solid rgba(95, 143, 106, 0.14);
}

.editor-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 12rpx;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.submit-feedback-btn,
.cancel-feedback-btn {
  flex: 1;
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.cancel-feedback-btn {
  background: #f3f4f1;
  color: #777;
}

.cancel-feedback-btn::after {
  border: none;
}