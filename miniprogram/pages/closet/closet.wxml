<view class="page">
  <!-- 顶部衣柜卡片 -->
  <view class="wardrobe-card">
    <view class="wardrobe-main">
      <view class="wardrobe-avatar">
        {{currentWardrobe.type === 'pet' ? '🐾' : '👕'}}
      </view>

      <view class="wardrobe-text">
        <view class="title">
          {{currentWardrobe.name || '我的衣橱'}}
        </view>

        <view class="subtitle">
          {{currentWardrobe.type === 'pet' ? '宠物衣柜' : '日常衣柜'}} · 已录入衣物
        </view>
      </view>

      <view class="header-actions">
        <button class="recommend-btn" bindtap="goRecommendation">
          推荐
        </button>

        <button class="switch-btn" bindtap="goWardrobes">
          切换
        </button>
      </view>
    </view>
  </view>

  <!-- 分类 -->
  <view class="section">
    <view class="section-title">衣物分类</view>

    <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="category-item {{currentCategory === item.value ? 'active' : ''}}"
          data-category="{{item.value}}"
          bindtap="onCategoryTap"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="empty-card">
    <view class="empty-title">加载中...</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{filteredClothes.length === 0}}" class="empty-card">
    <view class="empty-icon">👕</view>

    <view class="empty-title">
      {{currentWardrobe.name || '当前衣柜'}}暂无衣物
    </view>

    <view class="empty-desc">
      可以先添加几件衣物，系统才能为你推荐穿搭
    </view>

    <button class="empty-btn" bindtap="goAddItem">
      添加衣物
    </button>
  </view>

  <!-- 衣物列表 -->
  <view wx:else class="clothes-grid">
    <view
      wx:for="{{filteredClothes}}"
      wx:key="_id"
      class="clothing-card"
      data-id="{{item._id}}"
      bindtap="onClothingTap"
    >
      <image
        class="clothing-image"
        src="{{item.imageUrl}}"
        mode="aspectFill"
      ></image>

      <view class="clothing-info">
        <view class="clothing-name">
          {{item.name}}
        </view>

        <view class="clothing-meta">
          {{item.colorName || item.color}} · {{item.thickness}}
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮添加按钮 -->
  <button class="float-add-btn" bindtap="goAddItem">
    +
  </button>
</view>