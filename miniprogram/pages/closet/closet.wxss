.page {
  min-height: 100vh;
  background: #f6f7f5;
  padding: 32rpx 28rpx 140rpx;
  box-sizing: border-box;
}

.wardrobe-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(31, 42, 36, 0.06);
  margin-bottom: 32rpx;
}

.wardrobe-main {
  display: flex;
  align-items: center;
}

.wardrobe-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #e5f1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.wardrobe-text {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2a24;
  line-height: 1.2;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 25rpx;
  color: #8a948d;
  line-height: 1.4;
}

.switch-btn {
  margin: 0;
  width: 116rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #e5f1e7;
  color: #496253;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0;
  flex-shrink: 0;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a24;
  margin-bottom: 18rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #536057;
  font-size: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 42, 36, 0.04);
}

.category-item.active {
  background: #dcebdc;
  color: #1f2a24;
  font-weight: 700;
}

.empty-card {
  margin-top: 60rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 72rpx 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(31, 42, 36, 0.05);
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a24;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8a948d;
  margin-bottom: 32rpx;
}

.empty-btn {
  width: 320rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #dcebdc;
  color: #2d3a31;
  font-size: 27rpx;
  font-weight: 600;
}

.clothes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.clothing-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 36, 0.06);
}

.clothing-image {
  width: 100%;
  height: 260rpx;
  background: #eef0ec;
}

.clothing-info {
  padding: 18rpx 20rpx 20rpx;
}

.clothing-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2a24;
  margin-bottom: 8rpx;
}

.clothing-meta {
  font-size: 24rpx;
  color: #8a948d;
}

.float-add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  line-height: 88rpx;
  border-radius: 50%;
  background: #9abc8f;
  color: #ffffff;
  font-size: 54rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 120, 80, 0.3);
}

.recommend-btn {
  margin-left: 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #9abc8f;
  color: #ffffff;
  font-size: 24rpx;
}