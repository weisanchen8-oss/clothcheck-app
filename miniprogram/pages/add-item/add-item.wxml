<view class="page">
  <view class="wardrobe-card">
    <view class="wardrobe-info">
      <view class="wardrobe-label">正在添加到</view>
      <view class="wardrobe-name">{{currentWardrobe.name || '未选择衣柜'}}</view>
    </view>
    <button class="switch-btn" bindtap="goWardrobes">切换</button>
  </view>

  <view class="upload-card" bindtap="chooseImage">
    <image
      wx:if="{{tempImagePath}}"
      class="preview-image"
      src="{{tempImagePath}}"
      mode="aspectFill"
    ></image>

    <view wx:else class="upload-placeholder">
      <view class="upload-icon">＋</view>
      <view class="upload-title">上传衣物图片</view>
      <view class="upload-desc">支持拍照或从相册选择</view>
    </view>
  </view>

  <view wx:if="{{recognizing}}" class="status-card">
    AI 正在识别，请稍等...
  </view>

  <view class="form-card">
    <view class="form-title">确认衣物信息</view>

    <view class="form-item">
      <view class="label">衣物名称</view>
      <input
        class="input"
        value="{{form.name}}"
        placeholder="例如：白色衬衫"
        bindinput="onInputName"
      />
    </view>

    <view class="form-item">
      <view class="label">分类</view>
      <view class="option-list">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="option-item {{form.category === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onCategoryTap"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">子分类</view>
      <input
        class="input"
        value="{{form.subCategory}}"
        placeholder="例如：shirt / hoodie / coat"
        bindinput="onInputSubCategory"
      />
    </view>

    <view class="form-item">
      <view class="label">颜色</view>
      <input
        class="input"
        value="{{form.colorName}}"
        placeholder="例如：白色"
        bindinput="onInputColor"
      />
    </view>

    <view class="form-item">
      <view class="label">厚度</view>
      <view class="option-list">
        <view
          wx:for="{{thicknessOptions}}"
          wx:key="value"
          class="option-item {{form.thickness === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onThicknessTap"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="form-row">
      <view class="form-item half">
        <view class="label">最低温度</view>
        <input
          class="input"
          type="number"
          value="{{form.temperatureMin}}"
          bindinput="onTempMinInput"
        />
      </view>

      <view class="form-item half">
        <view class="label">最高温度</view>
        <input
          class="input"
          type="number"
          value="{{form.temperatureMax}}"
          bindinput="onTempMaxInput"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="label">材质</view>
      <input
        class="input"
        value="{{form.material}}"
        placeholder="例如：cotton / wool"
        bindinput="onInputMaterial"
      />
    </view>

    <button
      class="save-btn"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="saveClothing"
    >
      保存到 {{currentWardrobe.name || '当前衣柜'}}
    </button>
  </view>
</view>