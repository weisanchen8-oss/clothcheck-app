.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f7f5;
  box-sizing: border-box;
}

.upload-card {
  height: 420rpx;
  border-radius: 32rpx;
  background: #ffffff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
  color: #6b7b68;
}

.upload-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 32rpx;
  font-weight: 600;
}

.upload-subtext {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa597;
}

.status-card,
.ai-tip,
.confirm-tip {
  padding: 24rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.status-card {
  background: #fff7e6;
  color: #9a6b00;
}

.ai-tip {
  background: #eef7ea;
  color: #4f7a47;
}

.confirm-tip {
  background: #eaf4ff;
  color: #2d6f9f;
}

.form-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.half {
  flex: 1;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

input,
.picker {
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f6f7f5;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.checkbox-item {
  display: inline-flex;
  align-items: center;
  margin-right: 24rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.ai-meta {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f6f7f5;
  color: #6f756c;
  font-size: 24rpx;
}

.confirm-btn,
.save-btn {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.confirm-btn {
  background: #8aa884;
}

.save-btn {
  background: #5f9360;
}

button[disabled] {
  opacity: 0.55;
}