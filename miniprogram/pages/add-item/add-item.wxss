.page {
  min-height: 100vh;
  background: #f6f7f5;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.wardrobe-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 30rpx rgba(31, 42, 36, 0.06);
  margin-bottom: 28rpx;
}

.wardrobe-label {
  font-size: 24rpx;
  color: #8a948d;
  margin-bottom: 6rpx;
}

.wardrobe-name {
  font-size: 34rpx;
  color: #1f2a24;
  font-weight: 800;
}

.switch-btn {
  margin: 0;
  width: 116rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #e5f1e7;
  color: #496253;
  font-size: 24rpx;
  font-weight: 600;
  padding: 0;
}

.upload-card {
  height: 420rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(31, 42, 36, 0.06);
  margin-bottom: 28rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e5f1e7;
  color: #496253;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 20rpx;
}

.upload-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a24;
  margin-bottom: 10rpx;
}

.upload-desc {
  font-size: 25rpx;
  color: #8a948d;
}

.status-card {
  background: #fff7df;
  color: #7a5a16;
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

.form-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(31, 42, 36, 0.06);
}

.form-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2a24;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

.label {
  font-size: 26rpx;
  color: #4d5c53;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.input {
  height: 84rpx;
  background: #f6f7f5;
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2a24;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #f6f7f5;
  color: #536057;
  font-size: 26rpx;
}

.option-item.active {
  background: #dcebdc;
  color: #1f2a24;
  font-weight: 700;
}

.save-btn {
  margin-top: 36rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #9abc8f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}