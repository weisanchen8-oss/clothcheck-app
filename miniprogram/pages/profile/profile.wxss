.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f7f4;
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.card-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
}