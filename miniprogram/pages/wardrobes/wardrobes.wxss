.page {
  min-height: 100vh;
  background: #f6f7f4;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2a24;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: #6f7a72;
  line-height: 1.6;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #888;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wardrobe-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 42, 36, 0.06);
  border: 2rpx solid transparent;
}

.wardrobe-card.active {
  border-color: #7fa58b;
  background: #f8fff9;
}

.card-main {
  display: flex;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8efe9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a24;
}

.tag {
  font-size: 22rpx;
  color: #ffffff;
  background: #7fa58b;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.current-tag {
  font-size: 22rpx;
  color: #5b7f63;
  background: #e5f1e7;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.meta {
  font-size: 24rpx;
  color: #7b837d;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.small-btn {
  margin: 0;
  background: #7fa58b;
  color: #ffffff;
  border-radius: 999rpx;
}

.small-btn.secondary {
  background: #edf2ee;
  color: #496253;
}

.add-btn {
  margin-top: 36rpx;
  border-radius: 999rpx;
  background: #1f2a24;
  color: #ffffff;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.form-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  color: #1f2a24;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #4d5c53;
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  background: #f6f7f4;
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.radio {
  margin-right: 24rpx;
  font-size: 26rpx;
  color: #39443d;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  border-radius: 999rpx;
}

.cancel-btn {
  background: #eef0ec;
  color: #4d5c53;
}

.submit-btn {
  background: #7fa58b;
  color: #ffffff;
}